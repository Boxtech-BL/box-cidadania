# Copie para .env (fora da pasta pública) e ajuste os valores.
APP_ENV=local
APP_URL=http://localhost:8000
APP_NAME="Box Cidadania"
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cidadania
DB_USER=cidadania
DB_PASS=cidadania

# Chave para pseudonimizar votos e o IP (gere com: php -r "echo bin2hex(random_bytes(32));")
# Nunca troque depois de publicado: os votos deixariam de ser ligados aos usuários.
PSEUDONYM_KEY=

# E-mail: "log" grava em storage/mail (desenvolvimento); "smtp" envia pelo SMTP da Locaweb
MAIL_DRIVER=log
MAIL_HOST=email-ssl.com.br
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=
MAIL_PASS=
MAIL_FROM=nao-responda@boxtech.com.br
MAIL_FROM_NAME="Box Cidadania"

# Proteção contra manipulação
MAX_CADASTROS_POR_IP_DIA=5
MAX_LOGIN_FALHAS_15MIN=10

# Mínimo de participantes para exibir um resultado agregado
RESULTADO_MINIMO=100

# Versões vigentes dos textos legais (mude ao publicar nova versão)
TERMOS_VERSAO=2026-11-rascunho
CONSENTIMENTO_POLITICO_VERSAO=2026-11-rascunho
